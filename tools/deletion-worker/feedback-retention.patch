diff --git a/src/feedback-retention.mjs b/src/feedback-retention.mjs
new file mode 100644
index 0000000..cb45b6a
--- /dev/null
+++ b/src/feedback-retention.mjs
@@ -0,0 +1,18 @@
+const retentionMs = 90 * 24 * 60 * 60 * 1000;
+const batchSize = 500;
+
+export async function purgeExpiredFeedback(env, scheduledTime) {
+  if (env.FEEDBACK_RETENTION_ENABLED !== 'true') return;
+
+  const cutoff = new Date(scheduledTime - retentionMs).toISOString();
+  const result = await env.DB.prepare(
+    `DELETE FROM feedback WHERE id IN (
+       SELECT id FROM feedback
+       WHERE created_at < ?
+       ORDER BY created_at, id
+       LIMIT ?
+     )`
+  ).bind(cutoff, batchSize).run();
+
+  if (result.success === false) throw new Error('Feedback cleanup failed');
+}
