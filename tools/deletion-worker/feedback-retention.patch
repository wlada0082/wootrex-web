diff --git a/feedback-retention.test.mjs b/feedback-retention.test.mjs
new file mode 100644
index 0000000..1d4b890
--- /dev/null
+++ b/feedback-retention.test.mjs
@@ -0,0 +1,54 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { DatabaseSync } from 'node:sqlite';
+import test from 'node:test';
+import worker from './src/worker.js';
+
+test('retention is opt-in, bounded, repeatable and preserves the cutoff', async () => {
+  const sql = new DatabaseSync(':memory:');
+  try {
+    for (const file of ['0001_feedback.sql', '0003_feedback_retention.sql']) {
+      sql.exec(readFileSync(new URL('./migrations/' + file, import.meta.url), 'utf8'));
+    }
+    const insert = sql.prepare(
+      "INSERT INTO feedback (id, created_at, category, message, source) VALUES (?, ?, 'bug', 'Synthetic feedback', 'android')"
+    );
+    for (let i = 0; i < 501; i++) insert.run('old-' + i, '2026-01-01T00:00:00.000Z');
+    insert.run('boundary', '2026-01-02T00:00:00.000Z');
+    insert.run('recent', '2026-01-02T00:00:00.001Z');
+
+    const env = {
+      DB: {
+        prepare(query) {
+          return {
+            bind(...params) {
+              return { async run() { sql.prepare(query).run(...params); return { success: true }; } };
+            },
+          };
+        },
+      },
+    };
+    const count = () => sql.prepare('SELECT count(*) AS n FROM feedback').get().n;
+    async function cron() {
+      const pending = [];
+      await worker.scheduled({ scheduledTime: Date.parse('2026-04-02T00:00:00Z') }, env, {
+        waitUntil(promise) { pending.push(promise); },
+      });
+      await Promise.all(pending);
+    }
+
+    await cron();
+    assert.equal(count(), 503);
+    env.FEEDBACK_RETENTION_ENABLED = 'true';
+    await cron();
+    assert.equal(count(), 3);
+    await cron();
+    await cron();
+    assert.deepEqual(
+      sql.prepare('SELECT id FROM feedback ORDER BY id').all().map(row => row.id),
+      ['boundary', 'recent']
+    );
+  } finally {
+    sql.close();
+  }
+});
